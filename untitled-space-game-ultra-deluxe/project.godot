; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Untitled Space Game Ultra Deluxe"
config/tags=PackedStringArray("2025", "school")
run/main_scene="uid://dv4km2o3f32gn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Huntress and Michael Space Game"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://c31b5jdl1mcfb"

[autoload]

DamageTaken="*res://Scenes/Global/DamageTaken.tscn"
ConsoleCommands="*res://Scripts/Global/console_commands.gd"
global="*res://Scripts/Global/global.gd"
Online="*res://Scripts/Global/online.gd"
SaveData1="*res://Save Data/save_data_1.gd"
SaveData2="*res://Save Data/save_data_2.gd"
SaveData3="*res://Save Data/save_data_3.gd"
SignalBus="*res://Scripts/Global/signal_bus.gd"

[display]

window/subwindows/embed_subwindows=false
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/terrain_3d/plugin.cfg")

[file_customization]

folder_colors={
"res://Models/": "green",
"res://Save Data/": "teal",
"res://Scenes/": "red",
"res://Scripts/": "blue",
"res://Sprites/": "yellow",
"res://World Enviroments/": "pink",
"res://World Enviroments/Skyboxes/": "blue"
}

[global_group]

go_there="Stuff NPC's wanna go to"

